# ─── LLM API Keys ─────────────────────────────────────────────────────────────
# Điền một trong hai key bên dưới để kích hoạt RAG Advisor (sinh câu trả lời bằng LLM)
# Nếu không điền, hệ thống sẽ chạy ở chế độ fallback (trả về trích đoạn tài liệu)

# Option 1: OpenAI (gpt-4o-mini, gpt-4o, ...)
OPENAI_API_KEY=

# Option 2: Google Gemini (gemini-1.5-flash, gemini-pro, ...)
GEMINI_API_KEY=

# ─── Cấu hình thêm (tùy chọn) ────────────────────────────────────────────────
# HuggingFace token (để tăng rate limit khi download embedding model)
# HF_TOKEN=
